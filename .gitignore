# Python bytecode, caches, coverage, and tooling
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Packaging artifacts
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Local environments
.venv/
venv/
env/
.env
.env.*
!/.env.example

# Editors and operating systems
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.temp

# External seismic inputs are kept outside Git history. The repository retains
# only placeholder .gitignore files under data/; see data/README.md.
*.segy
*.sgy

# Generated datasets and experiment outputs. Current outputs/ subdirectories
# also contain local .gitignore files that retain only their placeholders.
synthetic_demo/
synthetic_thrust_data_v3/
real_thrust_fault_labels_v3/
patch_predictions/
fault3d_demo_*_reproduced/

# Compatibility ignores for output paths used by earlier versions
synthetic_thrust_data_with_background/
real_thrust_fault_labels_paper_style/
uassnet_outputs/
fault3d_output_*/
fault3d_display/
fault_lines_2d_*.pkl
fault_lines_2d_*.metadata.json
fault_lines_2d_*.npz

# Model checkpoints are local/external assets and are not distributed in this
# source-code repository. See ASSET_LICENSES.md and MODEL_CARD.md.
*.pth
*.pt
*.ckpt

# Pickles are local/generated artifacts and unsafe to load from untrusted
# sources. No pickle is distributed with this repository.
*.pkl

# Keep demo notebooks, source code, README, and display PNGs, but exclude
# machine-readable products regenerated by the demo workflows.
demo/**/*.npz
demo/**/*.csv
demo/**/*.json
